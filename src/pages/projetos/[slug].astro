---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  next: CollectionEntry<'projects'>;
}

const { project, index, next } = Astro.props;
const data = project.data;
const details = data.case;
const number = String(index + 1).padStart(2, '0');
const pageUrl = new URL(`/projetos/${project.id}/`, site.url).href;

const [wideAvif, wideWebp, tallAvif, tallWebp] = await Promise.all([
  getImage({ src: data.cover.wide, widths: [800, 1200, 1600, 2400], format: 'avif' }),
  getImage({ src: data.cover.wide, widths: [800, 1200, 1600, 2400], format: 'webp' }),
  getImage({ src: data.cover.tall, widths: [400, 800, 1200], format: 'avif' }),
  getImage({ src: data.cover.tall, widths: [400, 800, 1200], format: 'webp' }),
]);
const coverSizes = '(min-width: 1680px) 1552px, calc(100vw - 2 * var(--margin))';

const schema = [
  {
    '@type': 'CreativeWork',
    name: data.title,
    description: data.seoDescription,
    url: pageUrl,
    dateCreated: String(data.year),
    genre: `${data.category} / ${data.niche}`,
    keywords: data.stack.join(', '),
    creator: { '@id': `${site.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Projetos', item: `${site.url}/#projetos` },
      { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
    ],
  },
];

const facts = [
  { label: 'Categoria', value: data.category },
  { label: 'Nicho', value: data.niche },
  { label: 'Ano', value: String(data.year) },
  { label: 'Papel', value: details.role },
];
---

<BaseLayout
  title={`${data.title}: ${data.category} | Adryan Chaves`}
  description={data.seoDescription}
  schema={schema}
  image={`/og/${project.id}.jpg`}
  imageAlt={`Projeto ${data.title}: ${data.category}, ${data.niche}`}
>
  <article class="case">
    <header class="container case__header">
      <a class="case__back mono" href="/#projetos"><span aria-hidden="true">←</span> Todos os projetos</a>

      <div class="case__intro">
        <div class="case__top">
          <span class="case__index mono">{number}</span>
          <span class="case__status mono">{data.status}</span>
        </div>
        <h1 class="case__title">{data.title}</h1>
        <p class="case__lede">{details.lede}</p>
        <div class="case__actions">
          <Button href={data.link.href} external>{data.link.label}</Button>
          {data.repo && data.repo !== data.link.href && (
            <Button href={data.repo} external variant="ghost">Ver código</Button>
          )}
        </div>
      </div>

      <dl class="case__facts">
        {facts.map((fact) => (
          <div>
            <dt class="mono">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="container">
      <figure class="case__cover crop">
        <div class="case__cover-frame">
          <picture>
            <source media="(min-width: 768px)" type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={coverSizes} />
            <source media="(min-width: 768px)" type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={coverSizes} />
            <source type="image/avif" srcset={tallAvif.srcSet.attribute} sizes="100vw" />
            <img src={tallWebp.src} srcset={tallWebp.srcSet.attribute} sizes="100vw" alt={data.cover.alt} fetchpriority="high" />
          </picture>
        </div>
      </figure>
    </div>

    <section class="container case__summary" aria-label="Resumo do projeto">
      <div>
        <h2 class="case__label mono">Contexto</h2>
        <p>{details.context}</p>
      </div>
      <div>
        <h2 class="case__label mono">Objetivo</h2>
        <p>{details.objective}</p>
      </div>
      <div>
        <h2 class="case__label mono">Tecnologias</h2>
        <ul class="case__stack" role="list">
          {data.stack.map((item) => <li class="mono">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="container case__block" aria-labelledby="desafio">
      <h2 id="desafio" class="case__heading">O desafio</h2>
      <div class="case__body">
        <p class="case__big">{details.problem}</p>
        <p>{details.strategy}</p>
      </div>
    </section>

    <section class="container case__block" aria-labelledby="direcao">
      <h2 id="direcao" class="case__heading">{details.direction.title}</h2>
      <div class="case__body">
        <p>{details.direction.body}</p>
        {details.direction.tokens.length > 0 && (
          <ul class="tokens" role="list">
            {details.direction.tokens.map((token) => (
              <li class="tokens__item">
                {token.color ? (
                  <span class="tokens__swatch" style={`background-color: ${token.color}`} aria-hidden="true"></span>
                ) : (
                  <span class="tokens__swatch tokens__swatch--empty" aria-hidden="true">Aa</span>
                )}
                <span class="tokens__label mono">{token.label}</span>
                <span class="tokens__value">{token.value}</span>
              </li>
            ))}
          </ul>
        )}
        {details.direction.points.length > 0 && (
          <ul class="points" role="list">
            {details.direction.points.map((point) => <li>{point}</li>)}
          </ul>
        )}
      </div>
    </section>

    {data.gallery.length > 0 && (
      <section class="container case__gallery" aria-label="Telas do projeto">
        {data.gallery.map((shot) => (
          <figure class:list={['shot', `shot--${shot.device}`]}>
            <div class="shot__frame">
              <Picture
                src={shot.src}
                formats={['avif']}
                fallbackFormat="webp"
                widths={shot.device === 'desktop' ? [800, 1200, 1600] : [360, 720]}
                sizes={shot.device === 'desktop' ? '(min-width: 1024px) 70vw, 100vw' : '(min-width: 768px) 24vw, 320px'}
                alt={shot.alt}
                loading="lazy"
              />
            </div>
            <figcaption class="mono">{shot.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <section class="container case__block" aria-labelledby="implementacao">
      <h2 id="implementacao" class="case__heading">Implementação</h2>
      <div class="case__body">
        <p>{details.implementation.body}</p>
        <ul class="points" role="list">
          {details.implementation.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </section>

    {details.quality && (
      <section class="container case__block" aria-labelledby="qualidade">
        <h2 id="qualidade" class="case__heading">{details.quality.title}</h2>
        <div class="case__body">
          <p>{details.quality.body}</p>
          <ul class="points" role="list">
            {details.quality.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="container case__block" aria-labelledby="limites">
      <h2 id="limites" class="case__heading">O que este case não afirma</h2>
      <div class="case__body">
        <ul class="points points--muted" role="list">
          {details.limitations.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <nav class="container" aria-label="Próximo projeto">
      <a class="next" href={`/projetos/${next.id}/`}>
        <span class="next__label mono">Próximo projeto</span>
        <span class="next__title"><span class="link">{next.data.title}</span></span>
        <span class="next__meta mono">{next.data.category} / {next.data.niche}</span>
        <span class="next__arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </article>

  <FinalCta />
</BaseLayout>

<style>
  .case__header {
    display: grid;
    gap: 2.5rem var(--gutter);
    padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px));
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 44px;
    color: var(--color-muted);
    transition: color var(--dur-fast);
  }
  .case__back:hover { color: var(--color-text); }

  .case__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .case__index { color: var(--color-faint); }
  .case__status {
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .case__title {
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .case__lede {
    max-inline-size: 40ch;
    margin-top: 1.25rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case__facts {
    align-self: end;
    border-top: 1px solid var(--color-line);
  }
  .case__facts > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-line);
  }
  .case__facts dt {
    padding-top: 0.2rem;
    color: var(--color-faint);
  }
  .case__facts dd { font-size: 0.9375rem; }

  .case__cover {
    --crop-o: 14px;
    margin-top: clamp(40px, 6vw, 88px);
  }
  .case__cover-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background-color: var(--color-surface);
  }
  .case__cover-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__summary {
    display: grid;
    gap: 2rem var(--gutter);
    margin-top: clamp(56px, 7vw, 104px);
  }
  .case__label {
    margin-bottom: 0.625rem;
    font-weight: 400;
    color: var(--color-faint);
  }
  .case__summary p { max-inline-size: 42ch; }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .case__stack li {
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .case__block {
    display: grid;
    gap: 1.25rem var(--gutter);
    margin-top: clamp(56px, 7vw, 104px);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .case__heading {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .case__body {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 64ch;
    color: var(--color-muted);
  }
  .case__big {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text);
  }

  .points { border-top: 1px solid var(--color-line); }
  .points li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
  }
  .points--muted li { color: var(--color-muted); }

  .tokens {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.5rem;
  }
  .tokens__item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background-color: var(--color-bg-2);
  }
  .tokens__swatch {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
  }
  .tokens__swatch--empty {
    font-weight: 700;
    color: var(--color-text);
  }
  .tokens__label { color: var(--color-faint); }
  .tokens__value {
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .case__gallery {
    display: grid;
    gap: var(--gutter);
    align-items: start;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .shot__frame {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background-color: var(--color-surface);
  }
  .shot__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .shot--desktop .shot__frame { aspect-ratio: 16 / 10; }
  .shot--mobile { max-inline-size: 320px; }
  .shot--mobile .shot__frame { aspect-ratio: 9 / 16; border-radius: 20px; }
  .shot figcaption {
    margin-top: 0.75rem;
    color: var(--color-faint);
  }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-top: clamp(64px, 8vw, 120px);
    padding-block: clamp(28px, 4vw, 48px);
    border-block: 1px solid var(--color-line);
  }
  .next__label,
  .next__meta { grid-column: 1; color: var(--color-faint); }
  .next__title {
    grid-column: 1;
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .next__arrow {
    grid-column: 2;
    grid-row: 1 / span 3;
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .next:hover .next__arrow { transform: translateX(6px); }

  @media (min-width: 768px) {
    .case__cover-frame { aspect-ratio: 16 / 10; }
    .case__summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .case__gallery { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); }
    .shot--mobile { max-inline-size: none; }
  }

  @media (min-width: 1024px) {
    .case__header { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case__back { grid-column: 1 / -1; }
    .case__intro { grid-column: 1 / 9; }
    .case__facts { grid-column: 9 / -1; }

    .case__block { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case__heading { grid-column: 1 / 5; }
    .case__body { grid-column: 5 / -1; }
  }
</style>
