---
import SectionHeader from '../ui/SectionHeader.astro';
import { problems } from '../../data/content';
---

<section id="problemas" class="section" aria-labelledby="problemas-title">
  <SectionHeader
    id="problemas-title"
    title="Reconhece alguma dessas situações?"
    intro="São problemas comuns em empresas de todos os tamanhos. Nem todo problema pede um sistema novo, e a conversa serve para descobrir o que faz sentido."
  />

  <div class="container">
    <ul class="problems" role="list">
      {problems.map((item, i) => (
        <li class="problem" data-reveal-group data-reveal-rule>
          <span class="problem__number mono" data-reveal>{String(i + 1).padStart(2, '0')}</span>
          <h3 class="problem__title" data-reveal style="--i:1">{item.title}</h3>
          <p class="problem__text" data-reveal style="--i:2">{item.text}</p>
          <p class="problem__path" data-reveal style="--i:3">
            <span class="problem__label mono">Um caminho possível</span>
            {item.path}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problems { border-bottom: 1px solid var(--color-line); }

  .problem {
    display: grid;
    gap: 0.5rem var(--gutter);
    padding-block: clamp(20px, 2.5vw, 32px);
    border-top: 1px solid var(--color-line);
  }

  .problem__number { color: var(--color-faint); }

  .problem__title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .problem__text {
    max-inline-size: 48ch;
    color: var(--color-muted);
  }

  .problem__path {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .problem__label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-faint);
  }

  @media (min-width: 1024px) {
    .problem {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: baseline;
    }
    .problem__number { grid-column: 1 / 2; }
    .problem__title { grid-column: 2 / 6; }
    .problem__text { grid-column: 6 / 10; }
    .problem__path { grid-column: 10 / -1; margin-top: 0; }
  }
</style>
