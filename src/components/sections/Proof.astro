---
import SectionHeader from '../ui/SectionHeader.astro';
import { testimonials } from '../../data/proof';
---

{testimonials.length > 0 && (
  <section class="section" aria-labelledby="depoimentos-title">
    <SectionHeader id="depoimentos-title" title="O que dizem os clientes" />
    <div class="container">
      <ul class="quotes" role="list">
        {testimonials.map((item) => (
          <li>
            <figure class="quote">
              <blockquote class="quote__text">
                <p>{item.quote}</p>
              </blockquote>
              <figcaption class="quote__author">
                <span class="quote__name">{item.name}</span>
                <span class="quote__role">
                  {item.role}, {item.projectUrl ? <a href={item.projectUrl} target="_blank" rel="noopener noreferrer">{item.company}</a> : item.company}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .quotes {
    display: grid;
    gap: var(--gutter);
  }

  .quote {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .quote__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .quote__author {
    display: grid;
    gap: 0.125rem;
  }
  .quote__name { font-weight: 600; }
  .quote__role {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .quote__role a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .quotes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .quotes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
