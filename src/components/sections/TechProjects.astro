---
import SectionHeader from '../ui/SectionHeader.astro';
import { techProjects } from '../../data/content';
import { contact } from '../../data/site';
---

<section class="section" aria-labelledby="lab-title">
  <SectionHeader
    id="lab-title"
    size="md"
    title="Outros projetos técnicos"
    intro="Automação, dados e back-end: ferramentas e estudos publicados no GitHub."
  />

  <div class="container">
    <ul class="lab" role="list">
      {techProjects.map((project) => (
        <li data-reveal-group data-reveal>
          <a class="lab__row" data-reveal-rule href={project.repo} target="_blank" rel="noopener noreferrer">
            <div class="lab__head">
              <h3 class="lab__name"><span class="link">{project.name}</span></h3>
              <span class="lab__year mono">{project.year}</span>
            </div>
            <p class="lab__text">{project.summary}</p>
            <p class="lab__stack mono">{project.stack.join(' / ')}</p>
            <span class="lab__cta">Ver código<span class="lab__arrow" aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
      <li data-reveal-group data-reveal>
        <a class="lab__all" data-reveal-rule href={contact.github} target="_blank" rel="noopener noreferrer">
          <span class="link">Ver todos os repositórios no GitHub</span><span class="lab__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .lab { border-bottom: 1px solid var(--color-line); }

  .lab__row {
    display: grid;
    gap: 0.5rem var(--gutter);
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .lab__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .lab__name {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .lab__year { color: var(--color-faint); }

  .lab__text {
    max-inline-size: 60ch;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .lab__stack { color: var(--color-faint); }

  .lab__cta,
  .lab__all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .lab__arrow {
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-out);
  }
  a:hover .lab__arrow { transform: translate(2px, -2px); }

  .lab__all {
    width: 100%;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    transition: color var(--dur-fast);
  }
  .lab__all:hover { color: var(--color-text); }

  @media (min-width: 1024px) {
    .lab__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: baseline;
    }
    .lab__head { grid-column: 1 / 4; }
    .lab__text { grid-column: 4 / 9; }
    .lab__stack { grid-column: 9 / 11; }
    .lab__cta { grid-column: 11 / -1; justify-self: end; }
  }
</style>
