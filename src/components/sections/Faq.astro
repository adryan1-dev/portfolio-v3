---
import RiseText from '../ui/RiseText.astro';
import { faqs } from '../../data/content';
import { whatsappLink } from '../../data/site';
---

<section id="perguntas" class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__head" data-reveal-group>
      <h2 id="faq-title" class="faq__title"><RiseText text="Perguntas frequentes" /></h2>
      <p class="faq__note" data-reveal style="--i:2">
        Não encontrou sua dúvida?{' '}<a href={whatsappLink('Olá, Adryan! Tenho uma dúvida sobre como funciona um projeto de site.')} target="_blank" rel="noopener noreferrer" data-cursor-attach>Pergunte pelo WhatsApp</a>.
      </p>
    </div>

    <div class="faq__list" data-reveal-group>
      {faqs.map((item, i) => (
        <details class="faq__item" name="faq" data-reveal data-reveal-rule style={`--i:${i}`}>
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 2rem var(--gutter);
  }

  .faq__title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .faq__note {
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .faq__note a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast);
  }
  .faq__note a:hover { text-decoration-color: currentColor; }

  .faq__list {
    border-bottom: 1px solid var(--color-line);
    interpolate-size: allow-keywords;
  }

  .faq__item { border-top: 1px solid var(--color-line); }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 64px;
    padding-block: 1.125rem;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
  }
  .faq__question::-webkit-details-marker { display: none; }

  .faq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--color-muted);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background-color: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  /* Abertura suave onde houver suporte; nos outros navegadores abre direto */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-base) var(--ease-out),
      content-visibility var(--dur-base) allow-discrete;
  }
  .faq__item[open]::details-content { block-size: auto; }

  .faq__answer {
    max-inline-size: 60ch;
    padding-bottom: 1.5rem;
    padding-right: 2.5rem;
    color: var(--color-muted);
  }

  @media (min-width: 1024px) {
    .faq { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .faq__head {
      grid-column: 1 / 5;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
    .faq__list { grid-column: 6 / -1; }
  }
</style>
