---
import { contact, site, whatsappLink } from '../../data/site';

const links = [
  { label: 'LinkedIn', href: contact.linkedin, external: true },
  { label: 'GitHub', href: contact.github, external: true },
  { label: 'WhatsApp', href: whatsappLink(), external: true },
  { label: 'E-mail', href: `mailto:${contact.email}`, external: false },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a href="/" class="site-footer__wordmark" data-cursor-attach>{site.name}</a>
      <p class="site-footer__role">{site.role}</p>
    </div>

    <ul class="site-footer__links">
      {links.map((link) => (
        <li>
          <a
            data-cursor-attach
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            <span class="link">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="site-footer__legal mono">© {year} {site.person}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: 3rem max(2rem, env(safe-area-inset-bottom));
  }

  .site-footer__inner {
    display: grid;
    gap: 2rem;
  }

  .site-footer__wordmark {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .site-footer__role {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color var(--dur-fast);
  }
  .site-footer__links a:hover { color: var(--color-text); }

  .site-footer__legal { color: var(--color-faint); }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .site-footer__legal { grid-column: 1 / -1; }
  }
</style>
